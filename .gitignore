# ============================================
# CONFIGURATION LOCALE (SECRETS)
# ============================================
# Ne jamais versionner les mots de passe
config/mysql.php
.env
.env.local
*.env

# ============================================
# FICHIERS UPLOADÉS PAR LES UTILISATEURS
# ============================================
# Les images uploadées par les utilisateurs
uploads/*
!uploads/.gitkeep

# ============================================
# LOGS ET CACHE
# ============================================
*.log
logs/
cache/
tmp/

# ============================================
# IDE / ÉDITEURS
# ============================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

